<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- This console app's entire purpose is printing benchmark results/tables to stdout. -->
    <NoWarn>$(NoWarn);RS0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\common\Ark.Tools.Core\Ark.Tools.Core.csproj" />
    <ProjectReference Include="..\..\src\common\Ark.Tools.Core.Analyzers\Ark.Tools.Core.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
