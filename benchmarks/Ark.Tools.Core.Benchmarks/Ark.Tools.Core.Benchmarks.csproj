<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Benchmarks intentionally do not opt into the compile-time interceptors
         so that the harness always measures the reflection-based fallback in
         DataTableExtensions.ShredObjectToDataTable<T>. See Program.cs remarks
         for how the interceptor path is measured separately. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- This console app's entire purpose is printing benchmark results/tables to stdout. -->
    <NoWarn>$(NoWarn);RS0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\common\Ark.Tools.Core\Ark.Tools.Core.csproj" />
  </ItemGroup>

</Project>
