<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ApplicationIcon />
    <Version>1.2.3</Version>
    <OutputType>Exe</OutputType>
	  <IsPackable>false</IsPackable>
      <!-- SimpleInjector-composed host without an IServiceCollection: Microsoft telemetry
         is only a transitive reference and redaction cannot be registered here. -->
    <NoWarn>$(NoWarn);ARKPII013</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/common/Ark.Tools.Activity/Ark.Tools.Activity.csproj" />
  </ItemGroup>

</Project>
