<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup Label="Ark.Tools packages">
    <PackageVersion Include="Ark.Tools.AspNetCore.MessagePack" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.AspNetCore.OTel" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.AspNetCore.MinimalApi" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Dapper" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.MediatorFramework" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.MediatorFramework.AzureFunctions" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.MediatorFramework.Grpc" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.MediatorFramework.Messaging" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.MediatorFramework.MinimalApi" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.MediatorFramework.Rebus" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.NLog.Configuration" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Nodatime.Protobuf" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Outbox" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Outbox.Rebus" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Outbox.SqlServer" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Rebus" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Reqnroll" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Sql" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Sql.SqlServer" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Solid" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Solid.Authorization" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.SystemTextJson" Version="999.9.9" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.2" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>
  <ItemGroup Label="Sample dependencies">
    <PackageVersion Include="Google.Api.CommonProtos" Version="2.17.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.1" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" Version="5.24.0" />
    <PackageVersion Include="Microsoft.IdentityModel.LoggingExtensions" Version="8.22.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="8.22.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Validators" Version="8.22.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageVersion Include="Microsoft.SqlServer.DacFx" Version="170.4.83" />
    <PackageVersion Include="KubernetesClient" Version="19.0.2" />
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Polly" Version="8.7.0" />
    <PackageVersion Include="protobuf-net.Grpc.AspNetCore.Reflection" Version="1.3.14" />
