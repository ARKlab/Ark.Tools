    <PackageVersion Include="MSTest.Analyzers" Version="4.3.3" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.3.3" />
    <PackageVersion Include="Reqnroll.MsTest" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.Tools.MsBuild.Generation" Version="3.3.4" />
  </ItemGroup>
  <ItemGroup Label="Build tools">
    <PackageVersion Include="ErrorProne.NET.CoreAnalyzers" Version="0.1.2" />
