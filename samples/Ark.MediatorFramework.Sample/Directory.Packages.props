  </ItemGroup>
  <ItemGroup Label="Testing packages">
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="NodaTime.Testing" Version="3.3.3" />
    <PackageVersion Include="MSTest.Analyzers" Version="4.4.0" />
