<Project>
  <!--
    Azure Functions Worker SDK gap: with PublishAot there is no apphost, so _FunctionsGenerateWorkerConfig keeps
    "defaultExecutablePath": "dotnet" and "defaultWorkerPath": "<app>.dll", which Native AOT does not produce.
    The host requires the worker path to exist and passes it as the first argument: point both at the executable.
  -->
  <!--
    Worker SDK gap: the worker bootstraps through reflection over the app assembly (Assembly.GetTypes() for the generated
    IAutoConfigureStartup types, Activator.CreateInstance for WorkerExtensionStartupCodeExecutor) and activates its own
    middleware and converters by type without trimming annotations. Root those assemblies so trimming keeps them whole.
  -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="$(AssemblyName)" />
    <TrimmerRootAssembly Include="Microsoft.Azure.Functions.Worker.Core" />
    <TrimmerRootAssembly Include="Microsoft.Azure.Functions.Worker.Grpc" />
    <TrimmerRootAssembly Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
    <TrimmerRootAssembly Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" />
  </ItemGroup>

  <!-- Worker SDK gap: GrpcWorkerDiagnostics, worker indexing and the HTTP proxy read their own DTOs with
       reflection-based System.Text.Json. Their assemblies are rooted above, so the reflection resolver can see them. -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true' And '$(PublishAot)' != 'true'">
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <Target Name="_ArkFunctionsNativeAotWorkerConfig" AfterTargets="_FunctionsGenerateWorkerConfig" Condition="'$(PublishAot)' == 'true'">
    <WriteLinesToFile File="$(_FunctionsWorkerConfigPath)"
                      Lines="$([System.IO.File]::ReadAllText($(_FunctionsWorkerConfigPath)).Replace('&quot;defaultExecutablePath&quot;: &quot;dotnet&quot;', '&quot;defaultExecutablePath&quot;: &quot;{WorkerRoot}$(TargetName)&quot;').Replace('&quot;$(TargetName)$(TargetExt)&quot;', '&quot;$(TargetName)&quot;'))"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
