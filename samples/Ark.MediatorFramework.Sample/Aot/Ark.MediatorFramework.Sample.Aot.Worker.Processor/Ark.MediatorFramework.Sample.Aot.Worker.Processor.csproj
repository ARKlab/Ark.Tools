<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Pinned so the referenced libraries restore without a RID. -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <!-- Prototype: MessagePack, referenced by the messaging runtime, is not AOT-safe; keep its publish warnings visible but
         not fatal. Ark.Tools and this app produce none. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ark.Tools.Compliance" />
    <ProjectReference Include="..\Ark.MediatorFramework.Sample.Aot.Application\Ark.MediatorFramework.Sample.Aot.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
