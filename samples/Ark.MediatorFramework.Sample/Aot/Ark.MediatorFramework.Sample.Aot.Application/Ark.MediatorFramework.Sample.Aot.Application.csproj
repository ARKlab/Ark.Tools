<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Transport-neutral: the Functions and the Web hosts both reference it. ProblemDetails needs ASP.NET Core. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Ark.Tools.MediatorFramework.Messaging" />
    <PackageReference Include="Ark.Tools.MediatorFramework.Messaging.Azure" />
    <PackageReference Include="Ark.Tools.MediatorFramework" />
    <PackageReference Include="Ark.Tools.Solid" />
    <ProjectReference Include="../../../../src/mediator-framework/Ark.Tools.MediatorFramework.Generators/Ark.Tools.MediatorFramework.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
