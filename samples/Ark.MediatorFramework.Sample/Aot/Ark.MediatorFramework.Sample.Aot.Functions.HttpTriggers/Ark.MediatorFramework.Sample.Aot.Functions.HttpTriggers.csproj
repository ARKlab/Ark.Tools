<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Holds the Api's HttpHost. The Worker SDK source generators index and execute only functions they can see in
    referenced assemblies: they cannot see a function another generator emits in the same compilation.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ark.Tools.MediatorFramework.AzureFunctions" />
    <ProjectReference Include="..\Ark.MediatorFramework.Sample.Aot.Application\Ark.MediatorFramework.Sample.Aot.Application.csproj" />
  </ItemGroup>

</Project>
