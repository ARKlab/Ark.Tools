<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep Grpc.Net.Common at 2.84.0; removing this downgrades it to 2.80.0. TreatAsUsed silences ReferenceTrimmer RT0003. -->
    <PackageReference Include="Grpc.Net.Client" TreatAsUsed="true" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Google.Api.CommonProtos" />
    <PackageReference Include="Ark.Tools.Nodatime.Protobuf" />
    <PackageReference Include="Ark.Tools.MediatorFramework.Grpc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ark.MediatorFramework.Sample.Core.Web.WebInterface\Ark.MediatorFramework.Sample.Core.Web.WebInterface.csproj"
                      ReferenceOutputAssembly="false" />
    <!-- Listed by path, not globbed: the WebInterface exports the file during this build, after evaluation. -->
    <Protobuf Include="../Ark.MediatorFramework.Sample.Core.Web.WebInterface/proto/Books.proto"
              GrpcServices="Client"
              Link="Books.proto" />
    <Protobuf Update="@(Protobuf)"
              AdditionalImportDirs="$(NuGetPackageRoot)/google.api.commonprotos/2.17.0/content/protos;../Ark.MediatorFramework.Sample.Core.Web.WebInterface/proto" />
  </ItemGroup>

</Project>
