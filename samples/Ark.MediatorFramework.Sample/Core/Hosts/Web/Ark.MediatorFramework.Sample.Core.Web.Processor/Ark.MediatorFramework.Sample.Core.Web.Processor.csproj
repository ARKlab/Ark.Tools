<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- SimpleInjector-composed host: Microsoft telemetry is only a transitive reference. -->
    <NoWarn>$(NoWarn);ARKPII013</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Ark.Tools.NLog.Configuration" />
    <ProjectReference Include="..\Ark.MediatorFramework.Sample.Core.Web.Hosting\Ark.MediatorFramework.Sample.Core.Web.Hosting.csproj" />
  </ItemGroup>

</Project>
