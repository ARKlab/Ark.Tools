<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- An omitted value object reads as its primitive's default, as the primitive did, instead of throwing on
         Value: validators then report it as a field error. Vogen still runs Validate in From. -->
    <DefineConstants>$(DefineConstants);VOGEN_NO_VALIDATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ark.Tools.Compliance" />
    <PackageReference Include="Ark.Tools.Compliance.MessagePack" />
    <PackageReference Include="Microsoft.Extensions.Compliance.Abstractions" />
    <PackageReference Include="Ark.Tools.MediatorFramework" />
    <PackageReference Include="Ark.Tools.Nodatime.Protobuf" />
    <PackageReference Include="Ark.Tools.Solid" />
    <PackageReference Include="Ark.Tools.Solid.Authorization" />
    <PackageReference Include="Ark.Tools.SystemTextJson" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Vogen" />
  </ItemGroup>

</Project>
