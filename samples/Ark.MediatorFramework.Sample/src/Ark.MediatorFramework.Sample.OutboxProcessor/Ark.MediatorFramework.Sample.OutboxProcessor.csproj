<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
      <!-- SimpleInjector-composed host without an IServiceCollection: Microsoft telemetry
         is only a transitive reference and redaction cannot be registered here. -->
    <NoWarn>$(NoWarn);ARKPII013</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Ark.Tools.MediatorFramework.Messaging" Version="999.9.9" />
    <PackageReference Include="Ark.Tools.Outbox" Version="999.9.9" />
    <ProjectReference Include="..\Ark.MediatorFramework.Sample.Application\Ark.MediatorFramework.Sample.Application.csproj" />
    <ProjectReference Include="..\..\..\..\src\mediator-framework\Ark.Tools.MediatorFramework.Messaging.Azure\Ark.Tools.MediatorFramework.Messaging.Azure.csproj" />
  </ItemGroup>

</Project>
