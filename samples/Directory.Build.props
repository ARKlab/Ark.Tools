<Project>
  <PropertyGroup>
	<!-- Source-build harness; remove the local SDK imports when ejected. -->
	  <_ArkToolsSdkSourceBuild>true</_ArkToolsSdkSourceBuild>
    <!-- Samples dogfood the compliance analyzers even while the SDK default is opt-out. -->
    <EnableArkToolsCompliance>true</EnableArkToolsCompliance>
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    <!-- CopyToOutputDirectory=Always items copy only when they differ, so no-op builds stay no-op. -->
    <SkipUnchangedFilesOnCopyAlways Condition="'$(SkipUnchangedFilesOnCopyAlways)' == ''">true</SkipUnchangedFilesOnCopyAlways>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../src/sdk/Ark.Tools.Sdk/Sdk/Sdk.props" />

</Project>
