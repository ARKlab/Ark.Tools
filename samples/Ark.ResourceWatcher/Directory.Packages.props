<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ark.Tools packages - using local development version 999.9.9 -->
    <!-- When ejecting this sample to a new project, change these versions to the actual Ark.Tools version from nuget.org -->
    <PackageVersion Include="Ark.Tools.Http" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.NLog" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Reqnroll" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.ResourceWatcher.Testing" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.ResourceWatcher.WorkerHost.Hosting" Version="999.9.9" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- 3rd party packages used by this sample -->
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    
    <!-- Testing packages -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.4.0" />
    <PackageVersion Include="MSTest.Analyzers" Version="4.4.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Reqnroll.MsTest" Version="3.3.4" />
    <PackageVersion Include="Reqnroll.Tools.MsBuild.Generation" Version="3.3.4" />
    
    <!-- Build tools -->
    
    <!-- Security patches for transitive dependencies -->
    <PackageVersion Include="MailKit" Version="4.17.0" />

  </ItemGroup>

</Project>
