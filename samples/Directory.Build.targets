<Project InitialTargets="_ReplaceArkToolsReferences">
  <PropertyGroup>
    <!-- Define root relative to this file (samples/) -->
    <ArkToolsSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\src\'))</ArkToolsSourceRoot>
  </PropertyGroup>

   <PropertyGroup>
      <_ArkToolsImportGrpc Condition="'$(ArkToolsMediatorFrameworkGrpcHost)' == 'true' And Exists('$(ArkToolsSourceRoot)mediator-framework\Ark.Tools.MediatorFramework.Grpc\Ark.Tools.MediatorFramework.Grpc.csproj')">true</_ArkToolsImportGrpc>
      <_ArkToolsImportRebus Condition="'$(ArkToolsMediatorFrameworkRebusHost)' == 'true' And Exists('$(ArkToolsSourceRoot)mediator-framework\Ark.Tools.MediatorFramework.Rebus\Ark.Tools.MediatorFramework.Rebus.csproj')">true</_ArkToolsImportRebus>
      <_ArkToolsImportMediatorFramework Condition="Exists('$(ArkToolsSourceRoot)mediator-framework\Ark.Tools.MediatorFramework\Ark.Tools.MediatorFramework.csproj')">true</_ArkToolsImportMediatorFramework>
      <_ArkToolsImportSolid Condition="Exists('$(ArkToolsSourceRoot)common\Ark.Tools.Solid\Ark.Tools.Solid.csproj')">true</_ArkToolsImportSolid>
      <_ArkToolsImportCore Condition="Exists('$(ArkToolsSourceRoot)common\Ark.Tools.Core\Ark.Tools.Core.csproj')">true</_ArkToolsImportCore>
   </PropertyGroup>

  <Target Name="_ReplaceArkToolsReferences">
      <ItemGroup>
         <_ArkToolsCandidates Include="@(PackageReference)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('Ark.Tools'))">
            <CommonPath>$(ArkToolsSourceRoot)common\%(Identity)\%(Identity).csproj</CommonPath>
            <MediatorFrameworkPath>$(ArkToolsSourceRoot)mediator-framework\%(Identity)\%(Identity).csproj</MediatorFrameworkPath>
            <AspNetCorePath>$(ArkToolsSourceRoot)aspnetcore\%(Identity)\%(Identity).csproj</AspNetCorePath>
            <ResourceWatcherPath>$(ArkToolsSourceRoot)resourcewatcher\%(Identity)\%(Identity).csproj</ResourceWatcherPath>
         </_ArkToolsCandidates>
      </ItemGroup>
      
      <ItemGroup>
         <_ArkToolsToReplace Include="@(_ArkToolsCandidates)" Condition="Exists('%(CommonPath)')">
            <ProjectPath>%(CommonPath)</ProjectPath>
         </_ArkToolsToReplace>
         <_ArkToolsToReplace Include="@(_ArkToolsCandidates)" Condition="Exists('%(MediatorFrameworkPath)')">
            <ProjectPath>%(MediatorFrameworkPath)</ProjectPath>
         </_ArkToolsToReplace>
         <_ArkToolsToReplace Include="@(_ArkToolsCandidates)" Condition="Exists('%(AspNetCorePath)')">
            <ProjectPath>%(AspNetCorePath)</ProjectPath>
         </_ArkToolsToReplace>
         <_ArkToolsToReplace Include="@(_ArkToolsCandidates)" Condition="Exists('%(ResourceWatcherPath)')">
            <ProjectPath>%(ResourceWatcherPath)</ProjectPath>
         </_ArkToolsToReplace>
      </ItemGroup>

      <ItemGroup>
        <PackageReference Remove="@(_ArkToolsToReplace)" />
        <ProjectReference Include="@(_ArkToolsToReplace->'%(ProjectPath)')"
                          OutputItemType="%(_ArkToolsToReplace.OutputItemType)"
                          ReferenceOutputAssembly="%(_ArkToolsToReplace.ReferenceOutputAssembly)" />

        <!-- Package consumption gets these analyzers from analyzers/dotnet/cs. The sample's
             local PackageReference-to-ProjectReference replacement bypasses NuGet assets,
             and analyzer ProjectReferences are not transitive, so mirror those assets here. -->

        <ProjectReference Include="$(ArkToolsSourceRoot)common\Ark.Tools.Core.Analyzers\Ark.Tools.Core.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          Condition="@(_ArkToolsToReplace->Count()) > 0" />

        <ProjectReference Include="$(ArkToolsSourceRoot)common\Ark.Tools.Solid.Analyzers\Ark.Tools.Solid.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          Condition="'%(_ArkToolsToReplace.Identity)' == 'Ark.Tools.Solid'" />

         <ProjectReference Include="$(ArkToolsSourceRoot)common\Ark.Tools.Solid.Analyzers.CodeFixes\Ark.Tools.Solid.Analyzers.CodeFixes.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          Condition="'%(_ArkToolsToReplace.Identity)' == 'Ark.Tools.Solid'" />

        <ProjectReference Include="$(ArkToolsSourceRoot)mediator-framework\Ark.Tools.MediatorFramework.MinimalApi.Generators\Ark.Tools.MediatorFramework.MinimalApi.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          Condition="'%(_ArkToolsToReplace.Identity)' == 'Ark.Tools.MediatorFramework.MinimalApi' And '$(UsingMicrosoftNETSdkWeb)' == 'true'" />
        <ProjectReference Include="$(ArkToolsSourceRoot)mediator-framework\Ark.Tools.MediatorFramework.Rebus.Generators\Ark.Tools.MediatorFramework.Rebus.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          Condition="'%(_ArkToolsToReplace.Identity)' == 'Ark.Tools.MediatorFramework.Rebus' And '$(ArkToolsMediatorFrameworkRebusHost)' == 'true'" />
        <ProjectReference Include="$(ArkToolsSourceRoot)mediator-framework\Ark.Tools.MediatorFramework.Grpc.Generators\Ark.Tools.MediatorFramework.Grpc.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          Condition="'%(_ArkToolsToReplace.Identity)' == 'Ark.Tools.MediatorFramework.Grpc' And '$(ArkToolsMediatorFrameworkGrpcHost)' == 'true'" />
        <ProjectReference Include="$(ArkToolsSourceRoot)mediator-framework\Ark.Tools.MediatorFramework.AzureFunctions.Generators\Ark.Tools.MediatorFramework.AzureFunctions.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          Condition="'%(_ArkToolsToReplace.Identity)' == 'Ark.Tools.MediatorFramework.AzureFunctions'" />
        <ProjectReference Include="$(ArkToolsSourceRoot)mediator-framework\Ark.Tools.MediatorFramework.ApiSurface.Generators\Ark.Tools.MediatorFramework.ApiSurface.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          Condition="'%(_ArkToolsToReplace.Identity)' == 'Ark.Tools.MediatorFramework'" />
        <ProjectReference Include="$(ArkToolsSourceRoot)mediator-framework\Ark.Tools.MediatorFramework.Messaging.Generators\Ark.Tools.MediatorFramework.Messaging.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          Condition="'%(_ArkToolsToReplace.Identity)' == 'Ark.Tools.MediatorFramework'" />


      </ItemGroup>

      <Message Condition="@(_ArkToolsToReplace->Count()) > 0" Text="[Ark.Tools] Replaced PackageReference with ProjectReference for: @(_ArkToolsToReplace)" Importance="High" />
  </Target>

   <Import Project="$(ArkToolsSourceRoot)mediator-framework\Ark.Tools.MediatorFramework.Grpc\buildTransitive\Ark.Tools.MediatorFramework.Grpc.targets"
            Condition="'$(ArkToolsMediatorFrameworkGrpcHost)' == 'true'" />
   <Import Project="$(ArkToolsSourceRoot)mediator-framework\Ark.Tools.MediatorFramework.Rebus\buildTransitive\Ark.Tools.MediatorFramework.Rebus.props"
            Condition="'$(ArkToolsMediatorFrameworkRebusHost)' == 'true'" />
   <Import Project="$(ArkToolsSourceRoot)mediator-framework\Ark.Tools.MediatorFramework\buildTransitive\Ark.Tools.MediatorFramework.props"
            Condition="'$(UsingMicrosoftNETSdkWeb)' == 'true'" />
   <Import Project="$(ArkToolsSourceRoot)mediator-framework\Ark.Tools.MediatorFramework\buildTransitive\Ark.Tools.MediatorFramework.targets"
            Condition="'$(UsingMicrosoftNETSdkWeb)' == 'true'" />
   <Import Project="$(ArkToolsSourceRoot)common\Ark.Tools.Solid\buildTransitive\Ark.Tools.Solid.targets" />
   <Import Project="$(ArkToolsSourceRoot)common\Ark.Tools.Core\buildTransitive\Ark.Tools.Core.props" />
   <Import Project="$(ArkToolsSourceRoot)common\Ark.Tools.Core\buildTransitive\Ark.Tools.Core.targets" />
</Project>
