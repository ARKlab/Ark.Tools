<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup Label="Ark.Tools packages">
    <PackageVersion Include="Ark.Tools.Compliance" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Compliance.Dapper" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Dapper" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.MediatorFramework" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.MediatorFramework.Messaging" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.MediatorFramework.Messaging.Azure" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.MediatorFramework.MinimalApi" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Nodatime.Dapper" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Nodatime.SystemTextJson" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Outbox" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Solid" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.Sql.SqlServer" Version="999.9.9" />
    <PackageVersion Include="Ark.Tools.SystemTextJson" Version="999.9.9" />
  </ItemGroup>
  <ItemGroup Label="Sample dependencies">
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Dapper.AOT" Version="1.1.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Transitive pin: aligns the version Ark.Tools.MediatorFramework.MinimalApi builds against. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageVersion Include="NodaTime" Version="3.3.6" />
    <PackageVersion Include="Vogen" Version="8.0.7" />
  </ItemGroup>
  <ItemGroup Label="Testing packages">
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="MSTest.Analyzers" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.1" />
  </ItemGroup>
</Project>
