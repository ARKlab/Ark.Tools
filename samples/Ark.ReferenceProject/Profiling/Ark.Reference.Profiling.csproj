<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- References Swashbuckle 11, which needs OpenAPI.NET 3: see Directory.Packages.props. -->
    <ArkSwashbuckleOpenApi>true</ArkSwashbuckleOpenApi>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.SqlServer.DacFx" />
    <ProjectReference Include="..\Core\Ark.Reference.Core.InProcessHost\Ark.Reference.Core.InProcessHost.csproj" />
    <ProjectReference Include="..\Core\Ark.Reference.Core.Database\Ark.Reference.Core.Database.sqlproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Core\Ark.Reference.Core.Tests\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.IntegrationTests.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
