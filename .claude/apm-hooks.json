{
  "SessionStart": [
    {
      "matcher": "startup|resume|clear|compact",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Loading ponytail mode...",
          "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/'), 'hooks/ponytail-activate.js'))\"",
          "timeout": 5
        }
      ],
      "_apm_source": "dietrichgebert/ponytail"
    },
    {
      "matcher": "startup|clear|compact",
      "hooks": [
        {
          "type": "command",
          "shell": "bash",
          "async": false,
          "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/superpowers/hooks/run-hook.cmd\" session-start"
        }
      ],
      "_apm_source": "obra/superpowers"
    }
  ],
  "SubagentStart": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Loading ponytail mode...",
          "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/'), 'hooks/ponytail-subagent.js'))\"",
          "timeout": 5
        }
      ],
      "_apm_source": "dietrichgebert/ponytail"
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "statusMessage": "Tracking ponytail mode...",
          "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/'), 'hooks/ponytail-mode-tracker.js'))\"",
          "timeout": 5
        }
      ],
      "_apm_source": "dietrichgebert/ponytail"
    }
  ]
}
