{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>ARKlab/renovate-config"
  ],
  "constraints": {
    "dotnet": "10.0.402",
    "apm": "0.34.0"
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Process lock file maintenance before the slow NuGet branches so it is not starved by the 30 min job limit",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "prPriority": 10
    },
    {
      "description": "SQL Server tags encode the cumulative update in the suffix (2025-CU9-ubuntu-24.04); compare CU and GDR numbers and keep the Ubuntu base",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/mssql/server"
      ],
      "versioning": "regex:^(?<major>\\d+)-CU(?<minor>\\d+)(?:-GDR(?<patch>\\d+))?-(?<compatibility>ubuntu-[\\d.]+)$"
    },
    {
      "description": "constraints.apm and the apm-version of the workflows must move together, in one PR",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "microsoft/apm"
      ],
      "groupName": "apm CLI"
    },
    {
      "description": "Temporary cap, which also applies to the apm-guide tag in apm.yml: apm 0.35.0 deletes committed skills on a cold checkout and Renovate cannot pass --force. Remove once fixed upstream",
      "matchPackageNames": [
        "microsoft/apm"
      ],
      "allowedVersions": "<0.35.0"
    },
    {
      "description": "dotnet/skills publishes no plugin release tags: apm.yml pins its commit with a '# main' comment and Renovate tracks the main digest, batched weekly because main moves daily",
      "matchManagers": [
        "apm"
      ],
      "matchPackageNames": [
        "dotnet/skills"
      ],
      "overrideDatasource": "git-refs",
      "overridePackageName": "https://github.com/dotnet/skills",
      "groupName": "dotnet/skills plugins",
      "schedule": [
        "before 6am on monday"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^renovate.json$/"
      ],
      "matchStrings": [
        "\"dotnet\":\\s*\"(?<currentValue>.*?)\""
      ],
      "depNameTemplate": "dotnet-sdk",
      "datasourceTemplate": "dotnet-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "Azure Functions Core Tools installed with npm in the workflows",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "azure-functions-core-tools@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "azure-functions-core-tools",
      "datasourceTemplate": "npm"
    },
    {
      "description": "apm CLI installed by microsoft/apm-action in the workflows; constraints.apm is bumped by Renovate itself",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "apm-version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      "depNameTemplate": "microsoft/apm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ]
}
