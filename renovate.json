{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>ARKlab/renovate-config"
  ],
  "constraints": {
    "dotnet": "10.0.404",
    "apm": "0.39.0"
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Ark.Tools.AspNetCore.Swashbuckle is on Swashbuckle 11 and OpenAPI.NET 3: lift the shared Swashbuckle cap for this repository. Microsoft.OpenApi 2.x pins in the sample solutions stay capped by the shared config.",
      "matchDatasources": [
        "nuget"
      ],
      "matchSourceUrls": [
        "https://github.com/domaindrivendev/Swashbuckle.AspNetCore"
      ],
      "allowedVersions": "<12.0.0"
    },
    {
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "Swashbuckle.AspNetCore.Filters",
        "Swashbuckle.AspNetCore.Filters.Abstractions"
      ],
      "allowedVersions": "<12.0.0"
    },
    {
      "description": "OpenTelemetry 1.21.0 makes net10.0 apps deploy System.Diagnostics.DiagnosticSource 11.0.0, which .NET 10 runtime servicing does not patch. Stay on 1.20.x; upstream keeps the 11.0 dependency (open-telemetry/opentelemetry-dotnet#8140), so revisit when a net10.0 release no longer needs it",
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "OpenTelemetry",
        "OpenTelemetry.Api",
        "OpenTelemetry.Extensions.Hosting",
        "OpenTelemetry.Instrumentation.AspNetCore",
        "OpenTelemetry.Instrumentation.Http",
        "OpenTelemetry.Instrumentation.SqlClient"
      ],
      "allowedVersions": "<1.21.0"
    },
    {
      "description": "Process lock file maintenance before the slow NuGet branches so it is not starved by the 30 min job limit",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "prPriority": 10
    },
    {
      "description": "SQL Server tags encode the cumulative update in the suffix (2025-CU9-ubuntu-24.04); compare CU and GDR numbers and keep the Ubuntu base",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/mssql/server"
      ],
      "versioning": "regex:^(?<major>\\d+)-CU(?<minor>\\d+)(?:-GDR(?<patch>\\d+))?-(?<compatibility>ubuntu-[\\d.]+)$"
    },
    {
      "description": "dotnet/skills publishes no plugin release tags: apm.yml pins its commit with a '# main' comment and Renovate tracks the main digest, batched weekly because main moves daily",
      "matchManagers": [
        "apm"
      ],
      "matchPackageNames": [
        "dotnet/skills"
      ],
      "overrideDatasource": "git-refs",
      "overridePackageName": "https://github.com/dotnet/skills",
      "groupName": "dotnet/skills plugins",
      "schedule": [
        "before 6am on monday"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^renovate.json$/"
      ],
      "matchStrings": [
        "\"dotnet\":\\s*\"(?<currentValue>.*?)\""
      ],
      "depNameTemplate": "dotnet-sdk",
      "datasourceTemplate": "dotnet-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "Azure Functions Core Tools installed with npm in the workflows",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "azure-functions-core-tools@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "azure-functions-core-tools",
      "datasourceTemplate": "npm"
    },
    {
      "description": "apm CLI installed by microsoft/apm-action in the workflows; constraints.apm is bumped by Renovate itself",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "apm-version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      "depNameTemplate": "microsoft/apm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "description": "apm_version stamp of apm.lock.yaml: apm install rewrites it, so it must move with the CLI or the restore check in copilot-setup-steps goes red",
      "customType": "regex",
      "managerFilePatterns": [
        "/^apm\\.lock\\.yaml$/"
      ],
      "matchStrings": [
        "apm_version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      "depNameTemplate": "microsoft/apm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ]
}
