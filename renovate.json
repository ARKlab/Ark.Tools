{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>ARKlab/renovate-config"
  ],
  "constraints": {
    "dotnet": "10.0.402",
    "apm": "0.33.0"
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "apm": {
    "lockFileMaintenance": {
      "enabled": true
    }
  },
  "packageRules": [
    {
      "description": "Process lock file maintenance before the slow NuGet branches so it is not starved by the 30 min job limit",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "prPriority": 10
    },
    {
      "description": "SQL Server tags encode the cumulative update in the suffix (2025-CU9-ubuntu-24.04); compare CU and GDR numbers and keep the Ubuntu base",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/mssql/server"
      ],
      "versioning": "regex:^(?<major>\\d+)-CU(?<minor>\\d+)(?:-GDR(?<patch>\\d+))?-(?<compatibility>ubuntu-[\\d.]+)$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^renovate.json$/"
      ],
      "matchStrings": [
        "\"dotnet\":\\s*\"(?<currentValue>.*?)\""
      ],
      "depNameTemplate": "dotnet-sdk",
      "datasourceTemplate": "dotnet-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "Azure Functions Core Tools installed with npm in the workflows",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "azure-functions-core-tools@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "azure-functions-core-tools",
      "datasourceTemplate": "npm"
    }
  ]
}
