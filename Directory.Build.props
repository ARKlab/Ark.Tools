<Project>
  
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

	<!-- Default version for local development - allows samples to use locally built packages -->
	<!-- Override with -p:Version=x.y.z during release builds -->
	<Version Condition="'$(Version)' == ''">999.9.9</Version>
	<IsPackable>true</IsPackable>
	<_ArkToolsSdkSourceBuild>true</_ArkToolsSdkSourceBuild>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)src/sdk/Ark.Tools.Sdk/Sdk/Sdk.props" />

	<PropertyGroup>
		<ArkCoreInterceptorsEnabled Condition="'$(ArkCoreInterceptorsEnabled)' == ''">true</ArkCoreInterceptorsEnabled>
	</PropertyGroup>

	<ItemGroup>
		<CompilerVisibleProperty Include="ArkCoreInterceptorsEnabled" />
	</ItemGroup>

	<PropertyGroup Label="C# 14 Interceptors" Condition="'$(ArkCoreInterceptorsEnabled)' != 'false'">
		<!--
		Ark.Tools.Core ships a C# 14 interceptor generator (Ark.Tools.Core.Analyzers,
		ToDataTableArkInterceptorGenerator) that replaces compile-time-known
		ToDataTableArk<T>() calls with a direct, reflection-free DataTable construction.
		Published consumers get this automatically via the buildTransitive props packed
		into the Ark.Tools.Core NuGet package; monorepo projects that reference
		Ark.Tools.Core via ProjectReference (which does not flow NuGet build assets) need
		the namespace allow-listed here instead. Listing the namespace is inert unless a
		generator actually emits interceptors into it - see the interceptors.md spec at
		https://github.com/dotnet/roslyn/blob/main/docs/features/interceptors.md.
		-->
		<InterceptorsNamespaces>$(InterceptorsNamespaces);Ark.Tools.Core.Generated</InterceptorsNamespaces>
	</PropertyGroup>

	<PropertyGroup Label="Common Build Settings">

		<NoWarn>NU1701;1591;CS1998;NU1605</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>

		
		<EnablePackageValidation>true</EnablePackageValidation>
		
		<!--
		Disabling static graph restore due to a bug related to NuGetAuditSuppress.
		See: https://github.com/NuGet/Home/issues/14300
		-->
		<RestoreUseStaticGraphEvaluation>false</RestoreUseStaticGraphEvaluation>

	</PropertyGroup>

	<PropertyGroup Label="NuGet Audit Exceptions">
		<WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1905;</WarningsNotAsErrors>
	</PropertyGroup>

	<PropertyGroup Label="Temporary NuGet Pack Workaround">
		<!-- use this section for TEMPORARY workaround for Nuget Errors (prereleases or vulnerabilities with no fix) -->
		<NoWarn>$(NoWarn)</NoWarn>
	</PropertyGroup>

  <PropertyGroup Label="Test Settings" Condition="'$(IsTestProject)' == 'true'">
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
  </PropertyGroup>
  

	<PropertyGroup Label="NuGet Package Info" Condition="$(IsPackable) != 'false'">

		<PackageProjectUrl>https://github.com/ARKlab/Ark.Tools</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>ark-dark.png</PackageIcon>
		<RepositoryUrl>https://github.com/ARKlab/Ark.Tools</RepositoryUrl>      
		<Authors>ARK Labs</Authors>
		<Copyright>Copyright (C) 2024 ARK S.r.l</Copyright>

	</PropertyGroup>
  
	<ItemGroup Condition="$(IsPackable) != 'false'">
		<None Include="$(MSBuildThisFileDirectory)ark-dark.png" Pack="true" PackagePath="\" Condition="'$(IsPackable)' == 'true'"/>
	</ItemGroup>

    <PropertyGroup>
	    <!-- https://developercommunity.visualstudio.com/t/application-insight-doesnt-show-logs-from-local-de/1240506 -->
	    <!-- https://stackoverflow.com/a/64877356 -->
	    <ApplicationInsightsResourceId>/subscriptions/dummy</ApplicationInsightsResourceId>
    </PropertyGroup>

	<Target Name="_ExactProjectReferencesVersion" AfterTargets="_GetProjectReferenceVersions">
		<ItemGroup>
			<_ProjectReferencesWithExactVersions Include="@(_ProjectReferencesWithVersions)">
				<ProjectVersion>[%(_ProjectReferencesWithVersions.ProjectVersion)]</ProjectVersion>
			</_ProjectReferencesWithExactVersions>
		</ItemGroup>
		<ItemGroup>
			<_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
			<_ProjectReferencesWithVersions Include="@(_ProjectReferencesWithExactVersions)" />
		</ItemGroup>
	</Target>

</Project>
