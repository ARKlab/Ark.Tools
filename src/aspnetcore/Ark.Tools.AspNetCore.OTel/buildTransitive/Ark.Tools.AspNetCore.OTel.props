<Project>
  <!--
    Azure SDK tracing for Service Bus and Event Hubs is still experimental, and Azure.Core reads this switch only once,
    when the first Azure SDK client starts. Setting it in the runtime configuration turns it on before any code runs,
    even when Key Vault or App Configuration clients start before AddArkAzureMonitorOpenTelemetry.
    Set ArkEnableAzureSdkActivitySource to false to opt out.
  -->
  <ItemGroup Condition="'$(ArkEnableAzureSdkActivitySource)' != 'false'">
    <RuntimeHostConfigurationOption Include="Azure.Experimental.EnableActivitySource" Value="true" />
  </ItemGroup>
</Project>
