<Project Sdk="Microsoft.NET.Sdk">

  <!-- the other props are defined in Directory.Build.props -->
  <!--===================Configuration for Nuget Package=========================-->
  <PropertyGroup>

    <!-- Microsoft.AspNetCore.OpenApi ships net10.0 only. -->
    <TargetFrameworks>net10.0</TargetFrameworks>

    <Description>OpenAPI schema mappings for Ark.Tools.Compliance sensitive value objects</Description>
    <PackageTags>Ark;C#;.NET;Framework;Compliance;Privacy;PII;OpenApi</PackageTags>

    <!--Update these information when releasing a new version of the NugetPackage-->
    <PackageReleaseNotes></PackageReleaseNotes>

    <!-- Trimming configuration -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <!--===============================================================================-->

  <ItemGroup Label="Project-Specific Usings">
    <Using Include="Microsoft.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\compliance\Ark.Tools.Compliance\Ark.Tools.Compliance.csproj" />
  </ItemGroup>

  <!-- This library never calls AddOpenApi, so the XML comment generator output is unreachable; dropping the
       referenced projects' XML docs stops a doc change in any dependency from forcing a recompile. -->
  <Target Name="_ArkSkipOpenApiReferenceXml" AfterTargets="GenerateAdditionalXmlFilesForOpenApi">
    <ItemGroup>
      <AdditionalFiles Remove="@(AdditionalFiles)" Condition="'%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>

</Project>
