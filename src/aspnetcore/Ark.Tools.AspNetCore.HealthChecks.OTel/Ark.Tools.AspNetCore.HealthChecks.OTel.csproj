<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- the other props are defined in Directory.Build.props -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Description>OpenTelemetry metrics publisher for ASP.NET Core health checks.</Description>
    <PackageTags>Ark;C#;.NET;Framework;AspNetCore;OpenTelemetry;HealthChecks</PackageTags>
    <Version>$(AspNetCoreGroupVersion)</Version>
    <VersionSuffix>$(AspNetCoreGroupVersionSuffix)</VersionSuffix>
    <Version Condition="'$(VersionSuffix)' != ''">$(Version)-$(VersionSuffix)</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
