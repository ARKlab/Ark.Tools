<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PackageId>Ark.Tools.Sdk</PackageId>
    <Description>Ark.Tools additional MSBuild SDK.</Description>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128;NU5017;CA1016</NoWarn>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateSBOM>false</GenerateSBOM>
    <ArkToolsPackageProject>true</ArkToolsPackageProject>
    <PackageIcon></PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Sdk\Sdk.targets" Pack="true" PackagePath="Sdk/Sdk.targets" />
    <None Include="$(IntermediateOutputPath)Sdk.props" Pack="true" PackagePath="Sdk/Sdk.props" />
  </ItemGroup>

  <Target Name="GenerateSdkProps" BeforeTargets="Pack">
    <WriteLinesToFile
      File="$(IntermediateOutputPath)Sdk.props"
      Lines="&lt;Project&gt;&#xA;  &lt;ItemGroup Condition=&quot;'$(EnableArkToolsBuild)' != 'false'&quot;&gt;&#xA;    &lt;PackageReference Include=&quot;Ark.Tools.Build&quot; Version=&quot;$(PackageVersion)&quot; IsImplicitlyDefined=&quot;true&quot; /&gt;&#xA;  &lt;/ItemGroup&gt;&#xA;&lt;/Project&gt;"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>
</Project>
