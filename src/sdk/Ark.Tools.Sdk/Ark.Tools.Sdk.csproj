<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    
    <Description>Ark.Tools MSBuild SDK.</Description>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NU5128 is expected because this package intentionally contains only MSBuild assets. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateSBOM>false</GenerateSBOM>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Sdk\Sdk.targets" Pack="true" PackagePath="Sdk/Sdk.targets" />
    <None Include="Sdk\Sdk.props" Pack="true" PackagePath="Sdk/Sdk.props" />
    <None Include="common\common.targets" Pack="true" PackagePath="common\common.targets" />
    <None Include="common\common.props" Pack="true" PackagePath="common\common.props" />
    <None Include="common\tests.targets" Pack="true" PackagePath="common\tests.targets" />
    <None Include="common\ContinuousIntegrationBuild.props" Pack="true" PackagePath="common/ContinuousIntegrationBuild.props" />
  </ItemGroup>

</Project>
