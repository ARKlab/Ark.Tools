<Project>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true' and '$(EnableArkToolsMtpTestProfile)' != 'false'">
    <OutputType Condition="'$(OutputType)' == '' or '$(OutputType)' == 'Library'">Exe</OutputType>
  </PropertyGroup>

	<Import Project="$(MSBuildThisFileDirectory)tests.targets" Condition="'$(IsTestProject)' == 'true'" />

  
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(UsingMicrosoftBuildSqlSdk)' != 'true' and '$(ImplicitUsings)' != 'disable' and '$(EnableArkToolsGlobalUsings)' != 'false'">
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="System.Globalization" />
    <Using Include="System.Text" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsingMicrosoftBuildSqlSdk)' != 'true'">
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" IsImplicitlyDefined="true" PrivateAssets="all" Condition="'$(EnableArkToolsSbom)' != 'false'" />
    <PackageReference Include="Polyfill" Version="11.4.3" IsImplicitlyDefined="true" PrivateAssets="all" Condition="'$(EnableArkToolsPolyfill)' != 'false'" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" IsImplicitlyDefined="true" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" Condition="'$(EnableArkToolsBannedApi)' != 'false'" />
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.294" IsImplicitlyDefined="true" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" Condition="'$(EnableArkToolsMeziantouAnalyzer)' != 'false'" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" IsImplicitlyDefined="true" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" Condition="'$(EnableArkToolsVisualStudioThreading)' == 'true'" />
    <PackageReference Include="ErrorProne.NET.CoreAnalyzers" Version="0.1.2" IsImplicitlyDefined="true" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" Condition="'$(EnableArkToolsErrorProne)' != 'false'" />
    <PackageReference Include="ReferenceTrimmer" Version="3.5.9" IsImplicitlyDefined="true" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(EnableReferenceTrimmer)' != 'false'" />
    <PackageReference Include="Ark.Tools.Compliance.Analyzers" Version="$(ArkToolsSdkPackageVersion)" IsImplicitlyDefined="true" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" Condition="'$(EnableArkToolsCompliance)' == 'true' and '$(ArkToolsComplianceImplementationProject)' != 'true' and '$(_ArkToolsSdkSourceBuild)' != 'true'" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)../../../compliance/Ark.Tools.Compliance.Analyzers/buildTransitive/Ark.Tools.Compliance.Analyzers.props"
          Condition="'$(EnableArkToolsCompliance)' == 'true' and '$(ArkToolsComplianceImplementationProject)' != 'true' and '$(_ArkToolsSdkSourceBuild)' == 'true'" />

  <!-- ponytail: ReferenceTrimmer 3.5.9 hashes only reference identities, so TreatAsUsed/NoWarn edits leave stale RT000x in
       incremental builds. Feed that metadata into its input hash; relies on RT internals, drop once fixed upstream. -->
  <Target Name="_ArkReferenceTrimmerHashSuppressionMetadata"
          BeforeTargets="_PrepareCollectDeclaredReferences"
          Condition="'$(EnableReferenceTrimmer)' != 'false'">
    <ItemGroup>
      <_CollectDeclaredReferencesHashInputs Include="@(PackageReference -> 'PKGMETA=%(Identity)|%(TreatAsUsed)|%(NoWarn)')" />
      <_CollectDeclaredReferencesHashInputs Include="@(ProjectReference -> 'PRJMETA=%(Identity)|%(TreatAsUsed)|%(NoWarn)')" />
      <_CollectDeclaredReferencesHashInputs Include="@(Reference -> 'REFMETA=%(Identity)|%(TreatAsUsed)|%(NoWarn)')" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(EnableArkToolsAppSettings)' != 'false'">
    <Content Remove="$(MSBuildProjectDirectory)/appsettings*.json" />
    <Content Remove="$(MSBuildProjectDirectory)/appsettings.*.json" />
    <!-- IfDifferent resets an output copy a test or app changed, without copying on every build,
         so no-op builds stay no-op and the Visual Studio fast up-to-date check can skip them. -->
    <None Update="$(MSBuildProjectDirectory)/appsettings*.json">
      <CopyToOutputDirectory>IfDifferent</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="'%(Filename)' == 'appsettings'">Always</CopyToPublishDirectory>
      <CopyToPublishDirectory Condition="'%(Filename)' != 'appsettings'">Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

	<PropertyGroup>
		
    <_GitRef Condition="'$(_GitRef)' == '' and '$(GITHUB_REF)' != ''">$(GITHUB_REF)</_GitRef>
    <_GitRef Condition="'$(_GitRef)' == '' and '$(Build_SourceBranch)' != ''">$(Build_SourceBranch)</_GitRef>

    <_GitTagName Condition="'$(GITHUB_REF_TYPE)' == 'tag'">$(GITHUB_REF_NAME)</_GitTagName>
		<_GitTagName Condition="'$(_GitTagName)' == '' AND $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitRef)', '^refs/tags/'))">$([System.Text.RegularExpressions.Regex]::Replace('$(_GitRef)', '^refs/tags/', ''))</_GitTagName>
		
    <_GitTagVersion Condition="'$(_GitTagName)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_GitTagName)', '^[vV](?=\d)', ''))</_GitTagVersion>
		<_GitTagVersionIsValid Condition="'$(_GitTagVersion)' != ''">$([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitTagVersion)', '^(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$'))</_GitTagVersionIsValid>
    <GitTagVersion Condition="'$(_GitTagVersionIsValid)' == 'true'">$(_GitTagVersion)</GitTagVersion>
    
	</PropertyGroup>

</Project>