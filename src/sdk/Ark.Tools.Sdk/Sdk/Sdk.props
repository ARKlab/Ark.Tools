<!-- The Ark.Tools.Build version is replaced with the package version by GenerateSdkProps. -->
<Project>
  <Import Project="../../Ark.Tools.Build/build/Ark.Tools.Build.common.props"
          Condition="'$(ArkToolsSdkSourceBuild)' == 'true'" />

  <PropertyGroup>
    <_IsGitHubActions Condition="'$(_IsGitHubActions)' == '' and '$(GITHUB_ACTIONS)' == 'true'">true</_IsGitHubActions>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == '' and ('$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true' or '$(CI)' == 'true')">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile Condition="'$(RestorePackagesWithLockFile)' == ''">true</RestorePackagesWithLockFile>
    <RestoreSerializeGlobalProperties Condition="'$(RestoreSerializeGlobalProperties)' == ''">true</RestoreSerializeGlobalProperties>
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == '' and '$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit Condition="'$(NuGetAudit)' == ''">true</NuGetAudit>
    <NuGetAuditMode Condition="'$(NuGetAuditMode)' == ''">all</NuGetAuditMode>
    <NuGetAuditLevel Condition="'$(NuGetAuditLevel)' == ''">low</NuGetAuditLevel>
    <AnalysisLevel Condition="'$(AnalysisLevel)' == '' and '$(MSBuildProjectExtension)' == '.csproj' and '$(UsingMicrosoftBuildSqlSdk)' != 'true'">latest-all</AnalysisLevel>
    <LangVersion Condition="'$(LangVersion)' == '' and '$(MSBuildProjectExtension)' == '.csproj' and '$(UsingMicrosoftBuildSqlSdk)' != 'true'">14.0</LangVersion>
    <IsTestProject Condition="'$(IsTestProject)' == '' and ($(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.EndsWith('.UnitTests')))">true</IsTestProject>
    <GenerateSBOM Condition="'$(GenerateSBOM)' == '' and '$(EnableArkToolsBuild)' != 'false' and '$(EnableArkToolsSbom)' != 'false' and '$(MSBuildProjectExtension)' == '.csproj' and '$(UsingMicrosoftBuildSqlSdk)' != 'true'">true</GenerateSBOM>
    <PolyUseEmbeddedAttribute Condition="'$(PolyUseEmbeddedAttribute)' == '' and '$(EnableArkToolsBuild)' != 'false' and '$(EnableArkToolsPolyfill)' != 'false'">true</PolyUseEmbeddedAttribute>
    <AccelerateBuildsInVisualStudio Condition="'$(AccelerateBuildsInVisualStudio)' == '' and ('$(UsingMicrosoftNETSdk)' == 'true' or '$(UsingMicrosoftNETSdkWeb)' == 'true' or '$(UsingMicrosoftNETSdkRazor)' == 'true')">true</AccelerateBuildsInVisualStudio>
    <EnablePackageValidation Condition="'$(EnablePackageValidation)' == '' and '$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">true</EnablePackageValidation>
    <IncludeSymbols Condition="'$(IncludeSymbols)' == '' and '$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">true</IncludeSymbols>
    <SymbolPackageFormat Condition="'$(SymbolPackageFormat)' == '' and '$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    <OutputType>Exe</OutputType>
    <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute</ExcludeByAttribute>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' and '$(EnableArkToolsMtpTestProfile)' != 'false' and '$(EnableArkToolsDefaultTestSettings)' != 'false'">
    <MinimumExpectedTests Condition="'$(MinimumExpectedTests)' == ''">1</MinimumExpectedTests>
    <_ArkMtpCoverageArguments Condition="'$(ContinuousIntegrationBuild)' == 'true'"> --coverage --coverage-output-format cobertura</_ArkMtpCoverageArguments>
    <_ArkMtpMinimumExpectedTests Condition="'$(MinimumExpectedTests)' != '' and '$(MinimumExpectedTests)' != '0'"> --minimum-expected-tests $(MinimumExpectedTests)</_ArkMtpMinimumExpectedTests>
    <TestingPlatformCommandLineArguments Condition="'$(TestingPlatformCommandLineArguments)' == ''">--report-trx --crashdump-type mini --hangdump-type mini --hangdump-timeout 600$(_ArkMtpCoverageArguments)$(_ArkMtpMinimumExpectedTests)</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <PropertyGroup Label="Disable SourceLink for Copilot Sandboxes" Condition="'$(COPILOT_AGENT_ACTION)' != '' and '$(EnableArkToolsCopilotSandboxWorkaround)' != 'false'">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableArkToolsBuild)' != 'false' and '$(ArkToolsSdkSourceBuild)' != 'true'">
    <PackageReference Include="Ark.Tools.Build" Version="0.0.0" IsImplicitlyDefined="true" />
    <PackageReference Include="Polyfill" Version="11.2.0" IsImplicitlyDefined="true" PrivateAssets="all" Condition="'$(EnableArkToolsPolyfill)' != 'false'" />
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.5" IsImplicitlyDefined="true" PrivateAssets="all" Condition="'$(EnableArkToolsSbom)' != 'false' and '$(MSBuildProjectExtension)' == '.csproj' and '$(UsingMicrosoftBuildSqlSdk)' != 'true'" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" IsImplicitlyDefined="true" PrivateAssets="all" Condition="'$(EnableArkToolsSourceLink)' != 'false' and '$(IsPackable)' != 'false'" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true' and '$(ArkToolsSdkSourceBuild)' != 'true' and '$(EnableArkToolsMtpTestProfile)' != 'false'">
    <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" Version="2.3.3" IsImplicitlyDefined="true" PrivateAssets="all" Condition="'$(EnableArkToolsMtpCrashDump)' != 'false'" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" IsImplicitlyDefined="true" PrivateAssets="all" Condition="'$(EnableArkToolsMtpCodeCoverage)' != 'false'" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" IsImplicitlyDefined="true" PrivateAssets="all" Condition="'$(EnableArkToolsMtpHangDump)' != 'false'" />
    <PackageReference Include="Microsoft.Testing.Extensions.HotReload" Version="2.3.3" IsImplicitlyDefined="true" PrivateAssets="all" Condition="'$(EnableArkToolsMtpHotReload)' != 'false'" />
    <PackageReference Include="Microsoft.Testing.Extensions.Retry" Version="2.3.3" IsImplicitlyDefined="true" PrivateAssets="all" Condition="'$(EnableArkToolsMtpRetry)' != 'false'" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" IsImplicitlyDefined="true" PrivateAssets="all" Condition="'$(EnableArkToolsMtpTrxReport)' != 'false'" />
    <PackageReference Include="Microsoft.Testing.Extensions.AzureDevOpsReport" Version="2.3.3" IsImplicitlyDefined="true" PrivateAssets="all" Condition="'$(EnableArkToolsMtpAzureDevOpsReport)' != 'false'" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableArkToolsBuild)' != 'false' and '$(ArkToolsSdkSourceBuild)' != 'true' and '$(MSBuildProjectExtension)' == '.csproj' and '$(UsingMicrosoftBuildSqlSdk)' != 'true' and '$(ImplicitUsings)' != 'disable' and '$(EnableArkToolsGlobalUsings)' != 'false'">
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="System.Globalization" />
    <Using Include="System.Text" />
  </ItemGroup>
  <ItemGroup Condition="'$(ArkToolsSdkSourceBuild)' != 'true' and '$(MSBuildProjectExtension)' == '.csproj' and '$(UsingMicrosoftBuildSqlSdk)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400" IsImplicitlyDefined="true" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" Condition="'$(EnableArkToolsNetAnalyzers)' != 'false'" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" IsImplicitlyDefined="true" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" Condition="'$(EnableArkToolsBannedApi)' != 'false'" />
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.160" IsImplicitlyDefined="true" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" Condition="'$(EnableArkToolsMeziantouAnalyzer)' != 'false'" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" IsImplicitlyDefined="true" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" Condition="'$(EnableArkToolsVisualStudioThreading)' != 'false'" />
    <PackageReference Include="ErrorProne.NET.CoreAnalyzers" Version="0.1.2" IsImplicitlyDefined="true" PrivateAssets="all" IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" Condition="'$(EnableArkToolsErrorProne)' != 'false'" />
  </ItemGroup>
</Project>
