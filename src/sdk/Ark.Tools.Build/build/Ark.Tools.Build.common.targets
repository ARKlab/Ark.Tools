<Project>
  <PropertyGroup Condition="'$(ArkToolsBuildTargetsImported)' != 'true'">
    <ArkToolsBuildTargetsImported>true</ArkToolsBuildTargetsImported>
  </PropertyGroup>

  
	<!-- Ensure application can run with newer frameworks -->
	<PropertyGroup>
		<RollForward Condition="'$(RollForward)' == '' AND '$(IsTestProject)' != 'true'">LatestMajor</RollForward>
	</PropertyGroup>

	<PropertyGroup>
		<PackAsTool Condition="'$(PackAsTool)' == '' AND '$(OutputType)' == 'Exe' AND '$(IsTestProject)' != 'true'">true</PackAsTool>
	</PropertyGroup>

  <ItemGroup Condition="'$(UsingMicrosoftBuildSqlSdk)' != 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)../configuration/analyzers/Ark.Tools.BannedSymbols.txt"
                     KeepDuplicates="false"
                     Condition="'$(EnableArkToolsBannedApi)' != 'false'" />
  </ItemGroup>

  <Target Name="Disable_SponsorLink"
          BeforeTargets="CoreCompile"
          Condition="'$(EnableArkToolsSponsorLinkRemoval)' != 'false'">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(FileName)' == 'DevLooped.SponsorLink'" />
      <Analyzer Remove="@(Analyzer)" Condition="'%(FileName)' == 'Moq.CodeAnalysis'" />
    </ItemGroup>
  </Target>
</Project>
