<Project>
  <PropertyGroup Condition="'$(EnableArkToolsBuild)' != 'false' and '$(ArkToolsBuildTargetsImported)' != 'true'">
    <ArkToolsBuildTargetsImported>true</ArkToolsBuildTargetsImported>
    <_ArkToolsBuildTargetsImporting>true</_ArkToolsBuildTargetsImporting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_ArkToolsBuildTargetsImporting)' == 'true' and '$(ArkToolsBuildImported)' != 'true'">
    <ArkToolsBuildImported>true</ArkToolsBuildImported>
    <ArkToolsBuildImportCount>1</ArkToolsBuildImportCount>
  </PropertyGroup>

  <ItemGroup Condition="'$(_ArkToolsBuildTargetsImporting)' == 'true' and '$(UsingMicrosoftBuildSqlSdk)' != 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)../configuration/analyzers/Ark.Tools.BannedApi.BannedSymbols.txt"
                     Condition="'$(EnableArkToolsBannedApi)' != 'false'" />
  </ItemGroup>

  <Target Name="Disable_SponsorLink"
          BeforeTargets="CoreCompile"
          Condition="'$(EnableArkToolsBuild)' != 'false' and '$(EnableArkToolsSponsorLinkRemoval)' != 'false'">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(FileName)' == 'DevLooped.SponsorLink'" />
      <Analyzer Remove="@(Analyzer)" Condition="'%(FileName)' == 'Moq.CodeAnalysis'" />
    </ItemGroup>
  </Target>

  <PropertyGroup Condition="'$(_ArkToolsBuildTargetsImporting)' == 'true'">
    <_ArkToolsBuildTargetsImporting>false</_ArkToolsBuildTargetsImporting>
  </PropertyGroup>
</Project>
