<Project>
  <PropertyGroup Label="Common Build Settings"
                 Condition="'$(EnableArkToolsBuild)' != 'false' and '$(ArkToolsBuildImported)' != 'true'">
    <ArkToolsBuildImported>true</ArkToolsBuildImported>
    <ArkToolsBuildImportCount>1</ArkToolsBuildImportCount>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors Condition="'$(MSBuildTreatWarningsAsErrors)' == ''">true</MSBuildTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="C# Build Settings"
                 Condition="'$(EnableArkToolsBuild)' != 'false' and '$(MSBuildProjectExtension)' == '.csproj' and '$(UsingMicrosoftBuildSqlSdk)' != 'true'">
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">true</GenerateDocumentationFile>
    <Features Condition="'$(Features)' == ''">strict</Features>
    <ReportAnalyzer Condition="'$(ReportAnalyzer)' == ''">true</ReportAnalyzer>
    <EnforceCodeStyleInBuild Condition="'$(EnforceCodeStyleInBuild)' == ''">true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="SQL Build Settings"
                 Condition="'$(EnableArkToolsBuild)' != 'false' and '$(UsingMicrosoftBuildSqlSdk)' == 'true'">
    <TreatTSqlWarningsAsErrors Condition="'$(TreatTSqlWarningsAsErrors)' == ''">true</TreatTSqlWarningsAsErrors>
    <RunSqlCodeAnalysis Condition="'$(RunSqlCodeAnalysis)' == ''">true</RunSqlCodeAnalysis>
  </PropertyGroup>

  <PropertyGroup Label="Analyzer Configuration"
                 Condition="'$(EnableArkToolsBuild)' != 'false'">
    <ArkToolsLocalAnalyzerConfigRoot Condition="'$(ArkToolsLocalAnalyzerConfigRoot)' == '' and '$(DirectoryBuildPropsPath)' != ''">$([System.IO.Path]::GetDirectoryName('$(DirectoryBuildPropsPath)'))</ArkToolsLocalAnalyzerConfigRoot>
    <ArkToolsLocalAnalyzerConfigRoot Condition="'$(ArkToolsLocalAnalyzerConfigRoot)' == ''">$(MSBuildProjectDirectory)</ArkToolsLocalAnalyzerConfigRoot>
  </PropertyGroup>

  <ItemGroup Label="Analyzer Configuration"
             Condition="'$(EnableArkToolsBuild)' != 'false' and '$(UsingMicrosoftBuildSqlSdk)' != 'true'">
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)../configuration/coding-style/Ark.Tools.CodingStyle.editorconfig"
                       KeepDuplicates="false"
                       Condition="'$(EnableArkToolsCodingStyle)' != 'false'" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)../configuration/analyzers/Ark.Tools.NetAnalyzers.globalconfig"
                               KeepDuplicates="false"
                               Condition="'$(EnableArkToolsNetAnalyzers)' != 'false'" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)../configuration/analyzers/Ark.Tools.MeziantouAnalyzer.globalconfig"
                               KeepDuplicates="false"
                               Condition="'$(EnableArkToolsMeziantouAnalyzer)' != 'false'" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)../configuration/analyzers/Ark.Tools.ErrorProne.globalconfig"
                               KeepDuplicates="false"
                               Condition="'$(EnableArkToolsErrorProne)' != 'false'" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)../configuration/analyzers/Ark.Tools.VisualStudioThreading.globalconfig"
                               KeepDuplicates="false"
                               Condition="'$(EnableArkToolsVisualStudioThreading)' != 'false'" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)../configuration/analyzers/Ark.Tools.IdentityModel.globalconfig"
                               KeepDuplicates="false"
                               Condition="'$(EnableArkToolsIdentityModelConfiguration)' != 'false'" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)../configuration/analyzers/Ark.Tools.Core.globalconfig"
                               KeepDuplicates="false"
                               Condition="'$(EnableArkToolsCoreConfiguration)' != 'false'" />
    <GlobalAnalyzerConfigFiles Include="$(ArkToolsLocalAnalyzerConfigRoot)/.*.globalconfig"
                               KeepDuplicates="false"
                               Condition="'$(EnableArkToolsLocalAnalyzerConfigDiscovery)' != 'false'" />
  </ItemGroup>
</Project>
