<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BuildOutputTargetFolder>analyzers/dotnet/cs</BuildOutputTargetFolder>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <DevelopmentDependency>true</DevelopmentDependency>
    <ArkToolsComplianceAnalyzerProject>true</ArkToolsComplianceAnalyzerProject>
    <Description>Privacy declaration, fixture and sink diagnostics for Ark.Tools.</Description>
    <EnableArkToolsCompliance>false</EnableArkToolsCompliance>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ark.Tools.Compliance.Analyzers.Tests" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <None Update="buildTransitive/Ark.Tools.Compliance.Analyzers.props" Pack="true" PackagePath="buildTransitive/Ark.Tools.Compliance.Analyzers.props" />
    <None Update="buildTransitive/ComplianceLexicon.Ark.txt" Pack="true" PackagePath="buildTransitive/ComplianceLexicon.Ark.txt" />
    <None Update="buildTransitive/ComplianceSinks.Ark.txt" Pack="true" PackagePath="buildTransitive/ComplianceSinks.Ark.txt" />
    <Compile Include="../Ark.Tools.Compliance.Abstractions/Shared/PersonalDataPatterns.cs" Link="Shared/PersonalDataPatterns.cs" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <ProjectReference Include="../Ark.Tools.Compliance.Analyzers.CodeFixes/Ark.Tools.Compliance.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../Ark.Tools.Compliance.Analyzers.CodeFixes/bin/$(Configuration)/netstandard2.0/Ark.Tools.Compliance.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
