<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Analyzer-free compliance classification attributes and contracts for Ark.Tools.</Description>
    <PackageTags>Ark;C#;.NET;Framework;Compliance;Privacy;PII;Classification</PackageTags>
    <PackageReleaseNotes></PackageReleaseNotes>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Ark.Tools.Compliance.Shared/PiiPatternScanner.cs" Link="Shared/PiiPatternScanner.cs" />
    <PackageReference Include="Microsoft.Extensions.Compliance.Abstractions" />
  </ItemGroup>

</Project>
