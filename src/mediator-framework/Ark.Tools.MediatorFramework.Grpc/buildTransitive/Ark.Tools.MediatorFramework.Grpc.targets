<Project>
  <Target Name="ArkExportProto"
          AfterTargets="Build"
          Condition="'$(ArkExportProto)' == 'true' And '$(ArkExportProtoDir)' != '' And '$(IsTestProject)' != 'true'">
    <PropertyGroup>
      <_ArkProtoExportRunner Condition="Exists('$(MSBuildThisFileDirectory)..\tools\Ark.Tools.MediatorFramework.Grpc.Export.dll')">$(MSBuildThisFileDirectory)..\tools\Ark.Tools.MediatorFramework.Grpc.Export.dll</_ArkProtoExportRunner>
      <_ArkProtoExportRunner Condition="'$(_ArkProtoExportRunner)' == ''">$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Export\bin\$(Configuration)\net8.0\Ark.Tools.MediatorFramework.Grpc.Export.dll</_ArkProtoExportRunner>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(_ArkProtoExportRunner)&quot; &quot;$(TargetPath)&quot; &quot;$(ArkExportProtoDir)&quot;" />
  </Target>

  <Target Name="ArkCopyAdditionalProto"
          AfterTargets="ArkExportProto"
          Condition="'$(ArkExportProto)' == 'true' And '$(ArkExportProtoDir)' != ''">
    <Copy SourceFiles="@(ArkAdditionalProto)"
          DestinationFiles="@(ArkAdditionalProto->'$(ArkExportProtoDir)/%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
