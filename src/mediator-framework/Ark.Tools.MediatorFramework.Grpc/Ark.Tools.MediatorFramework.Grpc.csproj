<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <Description>Code-first gRPC transport runtime package for Ark.Tools MediatorFramework. Bundles source generation and automatic build-time export of generated service contracts, shared assets, and MapArkGrpcServicesFromAssembly for [GrpcMethod]-annotated contracts.</Description>
    <PackageTags>Ark;C#;.NET;Framework;Mediator;gRPC;Source Generator</PackageTags>
    <Version>$(ArkToolsCoreVersion)</Version>
    <VersionSuffix>$(ArkToolsCoreVersionSuffix)</VersionSuffix>
    <Version Condition="'$(VersionSuffix)' != ''">$(Version)-$(VersionSuffix)</Version>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Google.Api.CommonProtos" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.StatusProto" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="protobuf-net.Grpc.AspNetCore" />
    <PackageReference Include="System.ServiceModel.Primitives" />
    <!-- Core transport-agnostic attributes and attachment abstractions. -->
    <ProjectReference Include="..\..\common\Ark.Tools.Core\Ark.Tools.Core.csproj" />
    <ProjectReference Include="..\..\common\Ark.Tools.Authorization\Ark.Tools.Authorization.csproj" />
    <ProjectReference Include="..\Ark.Tools.MediatorFramework\Ark.Tools.MediatorFramework.csproj" />
    <ProjectReference Include="..\..\common\Ark.Tools.SystemTextJson\Ark.Tools.SystemTextJson.csproj" />
    <ProjectReference Include="..\Ark.Tools.MediatorFramework.Grpc.Export\Ark.Tools.MediatorFramework.Grpc.Export.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="proto/ark/mediator.proto" GrpcServices="None" />
    <EmbeddedResource Include="proto/ark/mediator.proto" />
    <None Include="proto/ark/mediator.proto" Pack="true"
          PackagePath="content/proto/ark;contentFiles/any/any/proto/ark" />
    <None Include="buildTransitive/Ark.Tools.MediatorFramework.Grpc.targets" Pack="true"
          PackagePath="buildTransitive" />
    <None Include="buildTransitive/Ark.Tools.MediatorFramework.Grpc.props" Pack="true"
          PackagePath="buildTransitive" />
  </ItemGroup>

  <!-- Pack the generator DLL into this NuGet package so that a PackageReference to
       Ark.Tools.MediatorFramework.Grpc automatically applies the analyzer. -->
  <Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Generators\bin\$(Configuration)\netstandard2.0\Ark.Tools.MediatorFramework.Grpc.Generators.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false"
            Condition="Exists('$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Generators\bin\$(Configuration)\netstandard2.0\Ark.Tools.MediatorFramework.Grpc.Generators.dll')" />
    </ItemGroup>
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Export\bin\$(Configuration)\net10.0\Ark.Tools.MediatorFramework.Grpc.Export.dll"
            Pack="true" PackagePath="tools" Visible="false"
            Condition="Exists('$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Export\bin\$(Configuration)\net10.0\Ark.Tools.MediatorFramework.Grpc.Export.dll')" />
      <None Include="$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Export\bin\$(Configuration)\net10.0\Ark.Tools.MediatorFramework.Grpc.Export.runtimeconfig.json"
            Pack="true" PackagePath="tools" Visible="false"
            Condition="Exists('$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Export\bin\$(Configuration)\net10.0\Ark.Tools.MediatorFramework.Grpc.Export.runtimeconfig.json')" />
      <None Include="$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Export\bin\$(Configuration)\net10.0\Ark.Tools.MediatorFramework.Grpc.Export.deps.json"
            Pack="true" PackagePath="tools" Visible="false"
            Condition="Exists('$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Export\bin\$(Configuration)\net10.0\Ark.Tools.MediatorFramework.Grpc.Export.deps.json')" />
      <None Include="$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Export\bin\$(Configuration)\net8.0\Ark.Tools.MediatorFramework.Grpc.Export.dll"
            Pack="true" PackagePath="tools/net8.0" Visible="false"
            Condition="Exists('$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Export\bin\$(Configuration)\net8.0\Ark.Tools.MediatorFramework.Grpc.Export.dll')" />
      <None Include="$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Export\bin\$(Configuration)\net8.0\Ark.Tools.MediatorFramework.Grpc.Export.runtimeconfig.json"
            Pack="true" PackagePath="tools/net8.0" Visible="false"
            Condition="Exists('$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Export\bin\$(Configuration)\net8.0\Ark.Tools.MediatorFramework.Grpc.Export.runtimeconfig.json')" />
      <None Include="$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Export\bin\$(Configuration)\net8.0\Ark.Tools.MediatorFramework.Grpc.Export.deps.json"
            Pack="true" PackagePath="tools/net8.0" Visible="false"
            Condition="Exists('$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Grpc.Export\bin\$(Configuration)\net8.0\Ark.Tools.MediatorFramework.Grpc.Export.deps.json')" />
    </ItemGroup>
  </Target>

</Project>
