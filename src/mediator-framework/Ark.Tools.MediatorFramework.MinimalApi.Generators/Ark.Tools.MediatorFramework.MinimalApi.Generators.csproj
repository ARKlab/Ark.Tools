<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateSBOM>false</GenerateSBOM>
    <Description>Source generator for Ark.Tools MediatorFramework Minimal API (ASP.NET Core) transport endpoint registration</Description>
    <PackageTags>Ark;C#;.NET;Framework;Mediator;MinimalAPI;Source Generator;Roslyn</PackageTags>
    <Version>$(ArkToolsCoreVersion)</Version>
    <VersionSuffix>$(ArkToolsCoreVersionSuffix)</VersionSuffix>
    <Version Condition="'$(VersionSuffix)' != ''">$(Version)-$(VersionSuffix)</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <GlobalAnalyzerConfigFiles Include="../../Generators.globalconfig" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Ark.Tools.MediatorFramework.Generators/GeneratorSpecPrimitives.cs" Link="GeneratorSpecPrimitives.cs" />
    <Compile Include="../Ark.Tools.MediatorFramework.Generators/ContractSymbols.cs" Link="ContractSymbols.cs" />
    <Compile Include="../Ark.Tools.MediatorFramework.Generators/ContractProperties.cs" Link="ContractProperties.cs" />
    <Compile Include="../Ark.Tools.MediatorFramework.Generators/ValueObjectSymbols.cs" Link="ValueObjectSymbols.cs" />
    <Compile Include="../Ark.Tools.MediatorFramework.Generators/HttpStringBinding.cs" Link="HttpStringBinding.cs" />
    <Compile Include="../Ark.Tools.MediatorFramework.Generators/XmlDocumentation.cs" Link="XmlDocumentation.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
