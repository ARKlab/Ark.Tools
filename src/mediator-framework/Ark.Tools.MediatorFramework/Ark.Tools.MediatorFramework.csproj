<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Transport markers and attachment abstractions for source-generated mediator endpoints</Description>
    <PackageTags>Ark;C#;.NET;Framework;Mediator;Minimal API;Rebus;gRPC</PackageTags>
    <Version>$(ArkToolsCoreVersion)</Version>
    <VersionSuffix>$(ArkToolsCoreVersionSuffix)</VersionSuffix>
    <Version Condition="'$(VersionSuffix)' != ''">$(Version)-$(VersionSuffix)</Version>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net" />
    <ProjectReference Include="..\Ark.Tools.MediatorFramework.Generators\Ark.Tools.MediatorFramework.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Ark.Tools.MediatorFramework.ApiSurface.Generators\Ark.Tools.MediatorFramework.ApiSurface.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <None Include="buildTransitive/Ark.Tools.MediatorFramework.props" Pack="true"
          PackagePath="buildTransitive" />
    <None Include="buildTransitive/Ark.Tools.MediatorFramework.targets" Pack="true"
          PackagePath="buildTransitive" />
  </ItemGroup>

  <Target Name="IncludeApiSurfaceGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.ApiSurface.Generators\bin\$(Configuration)\netstandard2.0\Ark.Tools.MediatorFramework.ApiSurface.Generators.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false"
            Condition="Exists('$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.ApiSurface.Generators\bin\$(Configuration)\netstandard2.0\Ark.Tools.MediatorFramework.ApiSurface.Generators.dll')" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeMessagingGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Generators\bin\$(Configuration)\netstandard2.0\Ark.Tools.MediatorFramework.Generators.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false"
            Condition="Exists('$(MSBuildThisFileDirectory)..\Ark.Tools.MediatorFramework.Generators\bin\$(Configuration)\netstandard2.0\Ark.Tools.MediatorFramework.Generators.dll')" />
    </ItemGroup>
  </Target>
</Project>
