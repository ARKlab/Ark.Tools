<Project>
  <PropertyGroup>
    <ArkApiSurfaceEnabled Condition="'$(ArkApiSurfaceEnabled)' == ''">true</ArkApiSurfaceEnabled>
    <ArkApiSurfaceCurrentFile>$(IntermediateOutputPath)ArkApiSurface.current.txt</ArkApiSurfaceCurrentFile>
  </PropertyGroup>

  <!-- Make the property visible to the Roslyn analyzer -->
  <ItemGroup Condition="'$(ArkApiSurfaceEnabled)' != 'false'">
    <CompilerVisibleProperty Include="ArkApiSurfaceEnabled" />
  </ItemGroup>

  <!-- Pass the baseline snapshot to the analyzer when it exists -->
  <ItemGroup Condition="'$(ArkApiSurfaceEnabled)' == 'true' And Exists('$(MSBuildProjectDirectory)/ArkApiSurface.txt')">
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/ArkApiSurface.txt" />
  </ItemGroup>

  <!-- Copy the generated snapshot to obj/ as a dev convenience only; diagnostics come from the analyzer -->
  <Target Name="ArkApiSurfaceWriteCurrent"
          AfterTargets="CoreCompile"
          Condition="'$(ArkApiSurfaceEnabled)' == 'true'">
    <Copy SourceFiles="$(CompilerGeneratedFilesOutputPath)/Ark.Tools.MediatorFramework.ApiSurface.Generators/Ark.MediatorFramework.ApiSurface.ApiSurfaceGenerator/ArkApiSurface.g.cs"
          DestinationFiles="$(ArkApiSurfaceCurrentFile)"
          Condition="Exists('$(CompilerGeneratedFilesOutputPath)/Ark.Tools.MediatorFramework.ApiSurface.Generators/Ark.MediatorFramework.ApiSurface.ApiSurfaceGenerator/ArkApiSurface.g.cs')" />
  </Target>
</Project>
