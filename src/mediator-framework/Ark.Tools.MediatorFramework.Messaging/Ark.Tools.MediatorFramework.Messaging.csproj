<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Transport-neutral messaging runtime for source-generated mediator endpoints</Description>
    <PackageTags>Ark;C#;.NET;Framework;Mediator;Messaging</PackageTags>
    <Version>$(ArkToolsCoreVersion)</Version>
    <VersionSuffix>$(ArkToolsCoreVersionSuffix)</VersionSuffix>
    <Version Condition="'$(VersionSuffix)' != ''">$(Version)-$(VersionSuffix)</Version>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Ark.Tools.MediatorFramework\Ark.Tools.MediatorFramework.csproj" />
  </ItemGroup>
</Project>
