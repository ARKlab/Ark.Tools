<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Default-on classification-aware NLog redaction for Ark applications.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="buildTransitive/**/*.cs" />
    <None Include="buildTransitive/**/*" Pack="true" PackagePath="buildTransitive/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="../Ark.Tools.Compliance/Ark.Tools.Compliance.csproj" />
    <ProjectReference Include="../Ark.Tools.NLog/Ark.Tools.NLog.csproj" />
    <PackageReference Include="NLog" />
  </ItemGroup>
</Project>
