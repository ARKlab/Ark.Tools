<Project Sdk="Microsoft.NET.Sdk">

  <!-- the other props are defined in Directory.Build.props -->
  <!--===================Configuration for Nuget Package=========================-->
  <PropertyGroup>

    <Description>OpenTelemetry sampling, filtering and enrichment utilities for Ark.Tools applications.</Description>
    <PackageTags>Ark;C#;.NET;Framework;OpenTelemetry;OTel;Sampling</PackageTags>

    <!--Update these information when releasing a new version of the NugetPackage-->
    <PackageReleaseNotes></PackageReleaseNotes>

    <Version>$(ArkToolsCoreVersion)</Version>
    <VersionSuffix>$(ArkToolsCoreVersionSuffix)</VersionSuffix>

    <Version Condition=" '$(VersionSuffix)' != '' ">$(Version)-$(VersionSuffix)</Version>

    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Source-generated Bind keeps the ArkAdaptiveSamplerOptions binding trim-safe. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <!--===============================================================================-->

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ark.Tools.OTel.Tests" />
    <!-- Its setup wires the sampler to the Ark filter processors, as AddArkOpenTelemetry does. -->
    <InternalsVisibleTo Include="Ark.Tools.ApplicationInsights" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../compliance/Ark.Tools.Compliance.Abstractions/Ark.Tools.Compliance.Abstractions.csproj" />
  </ItemGroup>

</Project>
