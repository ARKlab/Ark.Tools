<Project Sdk="Microsoft.NET.Sdk">

  <!-- the other props are defined in Directory.Build.props -->
  <!--===================Configuration for Nuget Package=========================-->
  <PropertyGroup>

    <Description>SOLID base for Handler pattern</Description>
    <PackageTags>Ark;C#;.NET;Framework;SOLID;Handler</PackageTags>

    <!--Update these information when releasing a new version of the NugetPackage-->
    <PackageReleaseNotes></PackageReleaseNotes>

    <Version>$(ArkToolsCoreVersion)</Version>
    <VersionSuffix>$(ArkToolsCoreVersionSuffix)</VersionSuffix>

    <Version Condition=" '$(VersionSuffix)' != '' ">$(Version)-$(VersionSuffix)</Version>

    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <!--===============================================================================-->

  <ItemGroup Label="Project-Specific Usings">
    <Using Include="NLog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ark.Tools.Core\Ark.Tools.Core.csproj" />
    <ProjectReference Include="..\Ark.Tools.NLog\Ark.Tools.NLog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ark.Tools.Solid.Analyzers\Ark.Tools.Solid.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Ark.Tools.Solid.Analyzers.CodeFixes\Ark.Tools.Solid.Analyzers.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <None Include="..\Ark.Tools.Solid.Analyzers\bin\$(Configuration)\netstandard2.0\Ark.Tools.Solid.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="..\Ark.Tools.Solid.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\Ark.Tools.Solid.Analyzers.CodeFixes.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="buildTransitive\Ark.Tools.Solid.targets"
          Pack="true"
          PackagePath="buildTransitive"
          Visible="false" />
  </ItemGroup>

</Project>
