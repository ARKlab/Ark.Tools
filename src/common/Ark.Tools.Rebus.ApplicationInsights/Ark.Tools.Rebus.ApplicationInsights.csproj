<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <!-- the other props are defined in Directory.Build.props -->
    <Description>Optional Application Insights v3 adapter for Rebus instrumentation.</Description>
    <PackageTags>Ark;C#;.NET;Rebus;ApplicationInsights;OpenTelemetry</PackageTags>
    <Version>$(ArkToolsCoreVersion)</Version>
    <VersionSuffix>$(ArkToolsCoreVersionSuffix)</VersionSuffix>
    <Version Condition="'$(VersionSuffix)' != ''">$(Version)-$(VersionSuffix)</Version>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ApplicationInsights" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ark.Tools.Rebus\Ark.Tools.Rebus.csproj" />
  </ItemGroup>
</Project>
