<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableArkToolsCompliance>true</EnableArkToolsCompliance>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/compliance/Ark.Tools.Compliance.Sql/Ark.Tools.Compliance.Sql.csproj" />
    <ProjectReference Include="../../src/compliance/Ark.Tools.Compliance.Generators/Ark.Tools.Compliance.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    <ProjectReference Include="../../src/compliance/Ark.Tools.Compliance.Analyzers/Ark.Tools.Compliance.Analyzers.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <ArkComplianceSqlToken Include="ComplianceSchema" Value="tenant]schema" />
    <ArkComplianceSqlToken Include="ComplianceLabel" Value="Customer's confidential data" />
    <None Include="Fixtures/SqlTokens.proj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/compliance/Ark.Tools.Compliance.Sql/buildTransitive/Ark.Tools.Compliance.Sql.targets"
          Link="Fixtures/Ark.Tools.Compliance.Sql.targets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The fixture runs import Fixtures/Ark.Tools.Compliance.Sql.targets, so the task goes where the package puts it. -->
  <PropertyGroup>
    <ArkComplianceSqlTasksAssembly>$(MSBuildThisFileDirectory)../../src/compliance/Ark.Tools.Compliance.Sql.Tasks/bin/$(Configuration)/netstandard2.0/Ark.Tools.Compliance.Sql.Tasks.dll</ArkComplianceSqlTasksAssembly>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(ArkComplianceSqlTasksAssembly)" Link="tasks/netstandard2.0/Ark.Tools.Compliance.Sql.Tasks.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Import Project="../../src/compliance/Ark.Tools.Compliance.Sql/buildTransitive/Ark.Tools.Compliance.Sql.targets" />

  <Target Name="_CopySqlFixtures" AfterTargets="ArkGenerateComplianceSql">
    <Copy SourceFiles="@(ArkComplianceSqlScript)" DestinationFolder="$(OutDir)ComplianceSql" SkipUnchangedFiles="true" />
  </Target>

</Project>
