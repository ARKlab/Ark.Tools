    <ProjectReference Include="../../src/sdk/Ark.Tools.Sdk/Ark.Tools.Sdk.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/compliance/Ark.Tools.Compliance.Analyzers/Ark.Tools.Compliance.Analyzers.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/compliance/Ark.Tools.Compliance.Abstractions/Ark.Tools.Compliance.Abstractions.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/common/Ark.Tools.Core/Ark.Tools.Core.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
